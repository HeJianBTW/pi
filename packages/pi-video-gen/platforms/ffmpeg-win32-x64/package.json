{
  "name": "@amaster.ai/pi-video-gen-ffmpeg-win32-x64",
  "version": "0.1.8",
  "description": "LGPL FFmpeg + GPL FFmpeg (libx264) runtime for pi-video-gen on win32 x64",
  "license": "SEE LICENSE IN SOURCE.md",
  "files": [
    "bin",
    "LICENSE",
    "GPLv2.txt",
    "ZLIB_LICENSE.txt",
    "SOURCE.md",
    "source"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "exports": {
    "./ffmpeg": "./bin/ffmpeg.exe",
    "./ffprobe": "./bin/ffprobe.exe"
  },
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "./bin/ffmpeg.exe",
      "./bin/ffprobe.exe",
      "./bin/ffmpeg-gpl.exe",
      "./bin/ffprobe-gpl.exe"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/pi-video-gen/platforms/ffmpeg-win32-x64"
  }
}
