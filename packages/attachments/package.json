    "directory": "packages/attachments"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@llamaindex/liteparse": "1.5.3",
    "jszip": "3.10.1"
  }
