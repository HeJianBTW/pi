{
  "name": "@amaster.ai/pi-storage",
  "version": "0.1.2-beta.9",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "default": "./dist/json.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./prisma/schema.prisma": {
      "default": "./prisma/schema.prisma"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "prisma",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TGYD-helige/pi.git",
    "directory": "packages/storage"
  },
  "bin": {
    "pi-storage-migrate": "./dist/migration-main.js"
  },
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -b",
    "db:migrate": "node ./dist/migration-main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "typecheck": "pnpm run prisma:generate && tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@amaster.ai/pi-task-scheduler": "workspace:*",
    "@amaster.ai/pi-shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "vitest": "^4.0.0"
  }
}
